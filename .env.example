TZ=America/Sao_Paulo
PUID=1000
PGID=1000
UMASK=002

# Host paths. shared is the default hardlink-compatible layout: downloads are
# ROOT_PATH/downloads and writers see one /data mount. separate is explicit:
# ROOT_PATH is the permanent library and DOWNLOADS_PATH is staging on another
# filesystem. The Linux installer then adds docker-compose.separate.yml.
# Use forward slashes (D:/media, not D:\media).
STORAGE_MODE=shared
ROOT_PATH=.
DOWNLOADS_PATH=./downloads
# Required by Linux separate mode; use the UUID of the permanent library disk.
# LIBRARY_MOUNT_UUID=

# Network exposure — fresh installs are loopback-only. Set PUBLIC_HOST and
# choose LAN mode through the Linux installer before exposing Jellyfin.
JELLYFIN_BIND_ADDRESS=127.0.0.1
MANAGEMENT_BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=127.0.0.1
JELLYFIN_REMOTE_ACCESS=false

# Angular dashboard (primary UI on :3000)
DASHBOARD_PORT=3000
# Host-published ports — Compose maps these and homepage-actions exposes them
# as browser deep links via GET /service-links (Angular Live sidebar / calendar).
JELLYFIN_PORT=8096
QBITTORRENT_WEBUI_PORT=8081
QBITTORRENT_PEER_PORT=6881
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
JELLYSEERR_PORT=5055
MAINTAINERR_PORT=6246

# Optional service profiles are disabled by default. Enable the matching
# profile and set its backend capability flag to true only after setup:
#   subtitles      -> Bazarr      (BAZARR_ENABLED=true)
#   requests       -> Jellyseerr  (JELLYSEERR_ENABLED=true)
#   maintenance    -> Maintainerr, Recyclarr, Unpackerr
#   indexer-tools  -> FlareSolverr
#   ai             -> model-agnostic AI Picks worker
# Example: docker compose --profile subtitles --profile requests up -d
BAZARR_ENABLED=false
JELLYSEERR_ENABLED=false

STACK_USERNAME=admin
STACK_PASSWORD=changeme
# Must match the password configured in qBittorrent WebUI (homepage-actions uses this for the API).
QBT_PASSWORD=changeme

MIN_FREE_SPACE_GIB=75

# Separate-storage disk guard policy is staged but no host supervisor is
# installed. These disabled values are inert until a later rollout supplies an
# explicit runner; setting the flag alone does not start one.
DISK_GUARD_ENABLED=false
DISK_GUARD_INTERVAL_SECONDS=5
DISK_GUARD_STAGING_RESERVE_GIB=75
DISK_GUARD_LIBRARY_RESERVE_GIB=50
DISK_GUARD_RESUME_MARGIN_GIB=10
DISK_GUARD_MAX_INFLIGHT_GIB=20

FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_CAPTCHA_SOLVER=none

# Service API keys (from config/<app>/config.xml or Jellyfin dashboard)
SONARR_API_KEY=your-sonarr-api-key
RADARR_API_KEY=your-radarr-api-key
PROWLARR_API_KEY=your-prowlarr-api-key
BAZARR_API_KEY=your-bazarr-api-key
JELLYFIN_API_KEY=your-jellyfin-api-key

# Random token shared by homepage-actions and the dashboard nginx proxy.
# install.ps1 generates one; any long random string works.
ACTIONS_TOKEN=your-actions-token

# Deterministic Sonarr queue hygiene (observe is report-only; auto preserves qBittorrent data)
QUEUE_HYGIENE_MODE=observe
QUEUE_HYGIENE_INTERVAL_SECONDS=300
QUEUE_HYGIENE_GRACE_SECONDS=21600
QUEUE_HYGIENE_STATE_PATH=/recommendations/queue-hygiene-state.json

# Verified qBittorrent original cleanup is disabled by default. When true,
# homepage-actions starts the scheduler and, every 300 seconds by default,
# revalidates imported torrents before asking qBittorrent to remove originals.
VERIFIED_CLEANUP_ENABLED=false
VERIFIED_CLEANUP_INTERVAL_SECONDS=300
VERIFIED_CLEANUP_STATE_PATH=/recommendations/verified-cleanup-state.json

# Discover — Jellyseerr request proxy + browse tabs
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=your-jellyseerr-api-key

# Discover — AI Picks + Trakt tab (OAuth app from https://trakt.tv/oauth/applications)
# AI Picks candidate source and Trakt tab.
TRAKT_CLIENT_ID=your-trakt-client-id
# Keep this secret local. It is used only by connect-trakt and the backend refresh client.
TRAKT_CLIENT_SECRET=your-trakt-client-secret
# Writable host state directory for renewable Trakt OAuth tokens (ignored by Git).
TRAKT_STATE_PATH=./.state/trakt
TRAKT_TOKEN_PATH=/state/trakt-token.json
# Private typed watched-identity cache; raw Trakt history is never persisted.
TRAKT_WATCHED_PATH=/state/trakt-watched.json
# Independent, default-off 48-hour retention. When enabled with valid Trakt
# OAuth configuration, homepage-actions starts its hourly scheduler.
TRAKT_RETENTION_ENABLED=false
TRAKT_RETENTION_INTERVAL_SECONDS=3600
TRAKT_RETENTION_STATE_PATH=/recommendations/trakt-retention-state.json

# Optional model-agnostic AI Picks worker (`docker compose --profile ai up -d --build`).
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_PICKS_TARGET_ACTIVE=20
AI_PICKS_ON_DEMAND_COUNT=10
AI_PICKS_LEASE_SECONDS=300
AI_PICKS_SCHEDULE_HOUR=10
AI_PICKS_COLLECTION_NAME=AI Picks
AI_POLL_INTERVAL_MS=2000
AI_MODEL_TIMEOUT_MS=60000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_SUPPORTS_STRUCTURED_OUTPUTS=false
