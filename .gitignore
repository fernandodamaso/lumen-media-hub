# Secrets — never commit
.env
.env.*
!.env.example

# Stack runtime state (app configs contain API keys)
/config/**
!/config/homepage-actions/
!/config/homepage-actions/**
/config/homepage-actions/__pycache__/
!/config/recommendations/
!/config/recommendations/schema-v2.json
!/config/recommendations/schema-v3.json
!/config/recommendations/schema-v4.json
!/config/recommendations/recommendations.example.json
!/config/recommendations/HERMES_DISCOVER_PROMPT.md
!/config/recommendations/README.md

# Media data (large volumes)
/downloads/
/media/
/tmp/
/.state/

# Ignore accidental local React dashboard tree (not part of this monorepo)
/dashboard/

# Ops scripts and ops docs (host-specific detail, hardcoded lab creds; not part of the public project)
/scripts/
/docs/

# Local scratch
.codex/
.scratch/
.superpowers/
.playwright-cli/
/IDEA.md
/fonts/

# Temp / OS
*.tmp
*.log
*.pid
.DS_Store
Thumbs.db
desktop.ini
.hermes/
