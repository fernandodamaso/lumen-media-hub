[Unit]
Description=Lumen permanent media library (ARQUIVOS)
Before=lumen-storage-writers.service
Conflicts=umount.target
Before=umount.target

[Mount]
What=/dev/disk/by-uuid/B8A426BFA4267FCC
Where=/run/media/admin/ARQUIVOS
Type=ntfs3
Options=uid=1000,gid=1000,umask=002

[Install]
WantedBy=multi-user.target
