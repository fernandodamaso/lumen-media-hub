TZ=America/Sao_Paulo
PUID=1000
PGID=1000
UMASK=002

# Host paths — install.ps1 fills these in. Use forward slashes (D:/media, not D:\media).
ROOT_PATH=.
DOWNLOADS_PATH=./downloads

# Vite dashboard (primary UI on :3000)
DASHBOARD_PORT=3000
JELLYFIN_PORT=8096
QBITTORRENT_WEBUI_PORT=8081
QBITTORRENT_PEER_PORT=6881
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
JELLYSEERR_PORT=5055
MAINTAINERR_PORT=6246

STACK_USERNAME=admin
STACK_PASSWORD=changeme

MIN_FREE_SPACE_GIB=75

FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_CAPTCHA_SOLVER=none

# qBittorrent WebUI password (homepage-actions proxy and *arr clients)
# Keep this equal to STACK_PASSWORD unless you intentionally split credentials.
QBT_PASSWORD=changeme

# Service API keys (from config/<app>/config.xml or Jellyfin dashboard)
SONARR_API_KEY=your-sonarr-api-key
RADARR_API_KEY=your-radarr-api-key
PROWLARR_API_KEY=your-prowlarr-api-key
BAZARR_API_KEY=your-bazarr-api-key
JELLYFIN_API_KEY=your-jellyfin-api-key

# Random token shared by homepage-actions and the dashboard nginx proxy.
# install.ps1 generates one; any long random string works.
ACTIONS_TOKEN=your-actions-token

# Discover — Jellyseerr request proxy + browse tabs
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=your-jellyseerr-api-key

# Discover — Hermes cron + Trakt tab (OAuth bearer from https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=your-trakt-client-id
TRAKT_ACCESS_TOKEN=your-trakt-access-token
