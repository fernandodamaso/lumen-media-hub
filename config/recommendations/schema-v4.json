{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.media/ai-picks/recommendations.schema-v4.json",
  "title": "AI Picks Recommendations v4",
  "description": "Versioned contract for config/recommendations/recommendations.json. v4 stores model-agnostic AI Picks and one durable generation job while preserving composite never-twice identities.",
  "type": "object",
  "required": ["version", "revision", "updated_at", "presented_media_ids", "items", "generation"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": 4 },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": { "type": "string" },
    "presented_media_ids": {
      "type": "array",
      "uniqueItems": true,
      "description": "Append-only deny set of composite identities. legacy:<id> conservatively blocks both movie:<id> and tv:<id>.",
      "items": {
        "type": "string",
        "pattern": "^(?:(?:movie|tv):[1-9][0-9]*|legacy:[1-9][0-9]*)$"
      }
    },
    "generation": {
      "type": ["object", "null"],
      "required": [
        "id", "status", "trigger", "requested_at", "started_at", "finished_at",
        "desired_count", "attempt", "lease_expires_at", "lease_token",
        "base_revision", "candidates", "taste", "required_retain", "error_code", "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["queued", "running", "succeeded", "failed"] },
        "trigger": { "enum": ["on_demand", "scheduled"] },
        "requested_at": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "desired_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attempt": { "type": "integer", "minimum": 0 },
        "lease_expires_at": { "type": ["string", "null"] },
        "lease_token": { "type": ["string", "null"] },
        "base_revision": { "type": ["integer", "null"], "minimum": 0 },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["identity", "type", "title", "tmdb_id"],
            "properties": {
              "identity": { "type": "string", "pattern": "^(?:movie|tv):[1-9][0-9]*$" },
              "type": { "enum": ["movie", "tv"] },
              "title": { "type": "string", "minLength": 1 },
              "tmdb_id": { "type": "integer", "minimum": 1 },
              "overview": { "type": "string" },
              "signals": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "taste": { "type": "object" },
        "required_retain": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:movie|tv):[1-9][0-9]*$" }
        },
        "error_code": { "type": ["string", "null"] },
        "counts": {
          "type": ["object", "null"],
          "required": ["accepted", "retained", "rotated", "rejected"],
          "properties": {
            "accepted": { "type": "integer", "minimum": 0 },
            "retained": { "type": "integer", "minimum": 0 },
            "rotated": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "identity",
          "source",
          "type",
          "title",
          "tmdb_id",
          "reason",
          "active",
          "feedback",
          "feedback_at",
          "request_state",
          "requested_at",
          "jellyseerr_request_id",
          "added_at"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ai-(?:movie|tv)-[1-9][0-9]*$"
          },
          "identity": {
            "type": "string",
            "pattern": "^(?:movie|tv):[1-9][0-9]*$"
          },
          "source": { "const": "ai" },
          "type": { "enum": ["movie", "tv"] },
          "title": { "type": "string" },
          "year": { "type": ["integer", "null"] },
          "tmdb_id": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string" },
          "active": { "type": "boolean" },
          "feedback": {
            "enum": [null, "liked", "disliked", "watched", "skipped"]
          },
          "feedback_at": { "type": ["string", "null"] },
          "request_state": { "enum": [null, "requested"] },
          "requested_at": { "type": ["string", "null"] },
          "jellyseerr_request_id": { "type": ["integer", "null"] },
          "poster_path": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "in_library": { "type": "boolean" },
          "jellyfin_id": { "type": ["string", "null"] },
          "poster_url": { "type": ["string", "null"] },
          "added_at": { "type": "string" },
          "trakt_history_event": {
            "type": ["object", "null"],
            "description": "Private Trakt delivery state persisted on watched feedback. Never exposed to the browser except through trakt_history_sync.status on read responses.",
            "required": [
              "event_id",
              "identity",
              "watched_at",
              "status",
              "attempts",
              "next_attempt_at",
              "error",
              "completed_at",
              "trakt_history_ids",
              "last_post_status"
            ],
            "additionalProperties": false,
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "identity": {
                "type": "string",
                "pattern": "^(?:movie|tv):[1-9][0-9]*$"
              },
              "watched_at": { "type": "string" },
              "status": {
                "enum": ["pending", "synced", "reconnect_required", "failed"]
              },
              "attempts": { "type": "integer", "minimum": 0 },
              "next_attempt_at": { "type": ["string", "null"] },
              "error": { "type": ["string", "null"] },
              "completed_at": { "type": ["string", "null"] },
              "trakt_history_ids": {
                "type": "array",
                "items": { "type": "integer" }
              },
              "last_post_status": { "type": ["integer", "null"] }
            }
          }
        }
      }
    }
  }
}
