[Unit]
Description=Lumen Phase 10A internal-storage capacity guard
Requires=docker.service
After=docker.service
ConditionPathExists=/home/admin/Projects/lumen-media-hub/.env

[Service]
Type=simple
WorkingDirectory=/home/admin/Projects/lumen-media-hub
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/admin/Projects/lumen-media-hub/installer
ExecStart=/usr/bin/python3 /home/admin/Projects/lumen-media-hub/installer/artifacts/phase10a/lumen-storage-guard.py
Restart=always
RestartSec=5
TimeoutStopSec=75

[Install]
WantedBy=multi-user.target
