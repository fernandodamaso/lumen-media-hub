{
  "name": "dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:live": "ng serve --configuration=live",
    "build": "ng build dashboard --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "storybook": "ng run dashboard:storybook",
    "build:storybook": "ng run dashboard:build-storybook",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006 --ci",
    "test:storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && npm run test-storybook\""
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@lucide/angular": "1.23.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.6",
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@compodoc/compodoc": "2.0.0",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/angular": "10.5.0",
    "@storybook/test-runner": "^0.24.4",
    "concurrently": "^10.0.3",
    "eslint": "^9.30.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "10.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  }
}
